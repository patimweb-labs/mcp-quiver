# Vorlage für den Server (keine echten Werte eintragen, nur Kopie als .env).
# Basis-URL, unter der der Server erreichbar ist. Fehlt sie, gilt
# http://localhost:<Port aus QUIVER_ADRESSE> – dann braucht die
# Ersteinrichtung keinen Einmal-Code, und der Server ist nur lokal erreichbar.
QUIVER_OEFFENTLICH=https://quiver.example.test
QUIVER_ADRESSE=0.0.0.0:8740
QUIVER_DATEN=./daten
QUIVER_ADMIN_DIST=./admin/dist

# Entra ID: alle drei oder keines. Mandant ist eine GUID, nie common.
# QUIVER_ENTRA_TENANT=00000000-0000-0000-0000-000000000000
# QUIVER_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Das Geheimnis gehört in eine Datei mit Rechten 0600, nie hierher:
# QUIVER_ENTRA_SECRET_DATEI=./daten/entra-secret
# Nur für Tests auf Loopback:
# QUIVER_ENTRA_AUTHORITY=http://127.0.0.1:8080

# Netze, von denen X-Forwarded-For geglaubt wird (CIDR, mit Komma getrennt).
# QUIVER_PROXIES=10.0.0.0/8,2001:db8::/32

# Geräte ohne Entra-Benutzer weiterlaufen lassen (erlaubt) oder abweisen (gesperrt).
QUIVER_ALTGERAETE=erlaubt

# Wird ignoriert (der Admin-Schlüssel gilt nicht mehr), nur als Hinweis:
# QUIVER_ADMIN_TOKEN=
