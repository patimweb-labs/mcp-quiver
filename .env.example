# Vorlage für den Server (keine echten Werte eintragen, nur Kopie als .env).
# Basis-URL, unter der der Server erreichbar ist. Fehlt sie, gilt
# http://localhost:<Port aus QUIVER_ADRESSE>.
QUIVER_OEFFENTLICH=https://quiver.example.test
QUIVER_ADRESSE=0.0.0.0:8740
QUIVER_DATEN=./daten
QUIVER_ADMIN_DIST=./admin/dist

# Ersteinrichtung: Sobald der Server nicht nur auf Loopback lauscht (also auch
# in diesem Container), ist der Einmal-Code aus dem Log Pflicht – unabhängig
# von der Basis-URL. Nur für einen rein lokalen Lauf (QUIVER_ADRESSE auf
# 127.0.0.1) darf er entfallen; das muss ausdrücklich hier stehen und wird
# beim Start laut gemeldet.
# QUIVER_EINRICHTUNG=ohne-code

# Entra ID: alle drei oder keines. Mandant ist eine GUID, nie common.
# QUIVER_ENTRA_TENANT=00000000-0000-0000-0000-000000000000
# QUIVER_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Das Geheimnis gehört in eine Datei mit Rechten 0600, nie hierher:
# QUIVER_ENTRA_SECRET_DATEI=./daten/entra-secret
# Nur für Tests auf Loopback:
# QUIVER_ENTRA_AUTHORITY=http://127.0.0.1:8080

# Programme für die Geräte (Aufgabe 37). Vorgabe: <QUIVER_DATEN>/tools und
# /opt/quiver/tools. Eigene Programme gehören in <QUIVER_DATEN>/tools/<system>/
# (nur root am Server, nichts über die Weboberfläche).
# QUIVER_PROGRAMME=/opt/quiver/tools

# Netze, von denen X-Forwarded-For geglaubt wird (CIDR, mit Komma getrennt).
# QUIVER_PROXIES=10.0.0.0/8,2001:db8::/32

# Geräte ohne Entra-Benutzer weiterlaufen lassen (erlaubt) oder abweisen
# (gesperrt). Mit eingerichtetem Entra gilt ohne Angabe „gesperrt“ (es gibt
# heute keine solchen Geräte mehr); ohne Entra bleibt der Weg offen.
# QUIVER_ALTGERAETE=gesperrt

# Wird ignoriert (der Admin-Schlüssel gilt nicht mehr), nur als Hinweis:
# Update-Hinweis (Aufgabe 34): darf der Server die GitHub-Veröffentlichungen
# nach einer neuen Version fragen? Höchstens alle sechs Stunden, ohne Kennung,
# ohne Nutzdaten. Ohne Angabe: an.
# QUIVER_UPDATES=aus
# Nur für Tests und Entwicklung: die Quelle auf Loopback zeigen lassen
# (im Betrieb fest das Repository des Projekts).
# QUIVER_UPDATE_QUELLE=http://127.0.0.1:8080
# QUIVER_ADMIN_TOKEN=
